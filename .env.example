# Skillet HTTP Server Docker configuration.
# Copy to .env (gitignored, never commit it) and fill in the tokens.

# Host port. docker-compose.yml publishes it on 127.0.0.1 only.
DOCKER_PORT=8080
# Host address to publish on. Change to 0.0.0.0 only behind TLS and a firewall.
# SKILLET_PUBLISH_ADDR=127.0.0.1

# Required: the container refuses to start if either is empty.
# Generate each with: openssl rand -hex 32
# (AUTH_TOKEN and ADMIN_TOKEN, the names used before BL-051, are no longer read.)
SKILLET_AUTH_TOKEN=
SKILLET_ADMIN_TOKEN=

# Optional: Custom hooks directory
# If you want to mount hooks from a different location, uncomment and modify:
# HOOKS_DIR=/path/to/your/custom/hooks
