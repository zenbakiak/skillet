#!/usr/bin/env bash
# Enforces ADR-0009 commit format. Bypass only with an explicit human decision (--no-verify).
set -euo pipefail
msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | head -n1)

fail() { printf 'commit-msg: %s\n  subject: %s\n  see docs/adr/0009-gitflow-branching-and-commits.md\n' "$1" "$subject" >&2; exit 1; }

# git-generated subjects
[[ "$subject" =~ ^(Merge|Revert\ \"|fixup!|squash!|amend!) ]] && exit 0

re='^(feat|fix|perf|refactor|style|docs|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: [^ ].*[^.]$'
[[ "$subject" =~ $re ]] || fail "subject must be '<type>(<scope>): <summary>' (no trailing period)"
(( ${#subject} <= 72 )) || fail "subject is ${#subject} chars, max 72"

second=$(grep -v '^#' "$msg_file" | sed -n 2p)
[[ -z "$second" ]] || fail "line 2 must be blank"

if grep -v '^#' "$msg_file" | grep -qiE '^co-authored-by:|generated with \[?(claude|codex|cursor|copilot)|🤖'; then
  fail "no agent attribution / Co-authored-by trailers"
fi
