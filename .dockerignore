# Minimal dockerignore for Alpine binary builds
# Only exclude what's absolutely necessary

# Build artifacts (but include Cargo.lock!)
target/

# Git
.git/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Large test/bench output (not needed for build). benches/ must stay in the context:
# Cargo.toml declares [[bench]] targets, and cargo refuses to parse the manifest without them.
performance_results/
